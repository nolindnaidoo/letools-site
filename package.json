{
  "name": "letools-site",
  "version": "0.1.0",
  "private": true,
  "description": "The hub site for the LE family of VS Code extensions — ten single-purpose devtools at letools.dev.",
  "author": {
    "name": "Nolin Naidoo",
    "email": "nolin.naidoo@me.com",
    "url": "https://github.com/nolindnaidoo"
  },
  "license": "MIT",
  "homepage": "https://letools.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nolindnaidoo/letools-site.git"
  },
  "bugs": {
    "url": "https://github.com/nolindnaidoo/letools-site/issues"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check:ovsx-links": "bun scripts/check-openvsx-links.ts",
    "check:fleet": "bun scripts/check-fleet.ts",
    "check:doc-paths": "bun scripts/check-doc-paths.ts",
    "check:demos": "bun scripts/check-demos.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run typecheck && bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budget": "bun scripts/check-budget.ts",
    "lint:commits": "node scripts/commit-lint.js --range \"${BASE_SHA:-origin/main}\" \"${HEAD_SHA:-HEAD}\"",
    "hooks:install": "git config core.hooksPath .githooks",
    "routes": "bun scripts/check-routes.ts",
    "sync:demos": "bun scripts/sync-demos.ts",
    "verify:deploy": "bun run lint && bun run typecheck && bun run check:registry && bun run test:coverage && bun run build && bun run routes && bun run budget",
    "sync:registry": "bun scripts/sync-registry.ts",
    "sync:readmes": "bun scripts/sync-readmes.ts",
    "check:registry": "bun scripts/sync-registry.ts --check",
    "check:crates": "bun scripts/check-crates.ts",
    "check:publication-claims": "bun scripts/check-publication-claims.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
